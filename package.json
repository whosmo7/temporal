{
  "name": "temporal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worldgen": "vite --open '/temporal/#/dev/worldgen'",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc -p supabase/functions/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "worldgen": "tsx scripts/worldgen-preview.ts",
    "simulate": "tsx scripts/simulate.ts",
    "simulate:llm": "tsx scripts/simulate-llm.ts",
    "atlas": "tsx scripts/build-atlas.ts",
    "audio": "tsx scripts/build-audio.ts",
    "functions:bundle": "tsx scripts/bundle-engine.ts",
    "functions:deploy": "npm run functions:bundle && supabase functions deploy commit-turn --use-api && supabase functions deploy seed-demo --use-api && supabase functions deploy llm-simulate --use-api",
    "check:decisions": "tsx scripts/check-decisions.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^14.6.0",
    "howler": "^2.2.4",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/genai": "^2.31.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
